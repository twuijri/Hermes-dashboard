# NextAuth session secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Admin user (prefer hashed password)
ADMIN_USERNAME=admin
# Bcrypt hash (base64-encoded to survive .env $-expansion). Generate with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('YOUR_PASSWORD', 10)).toString('base64'))"
ADMIN_PASSWORD_HASH_B64=

# OR plaintext (ignored if ADMIN_PASSWORD_HASH_B64 is set)
# ADMIN_PASSWORD=

# Upstream Hermes dashboard — must be 127.0.0.1 in production
HERMES_DASHBOARD_URL=http://127.0.0.1:9119
